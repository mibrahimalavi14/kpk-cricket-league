<%- include('partials/header', { active: 'leaders', pageTitle: 'Leaders' }) %>

<section class="hero" style="min-height:35vh">
  <div class="hero-content">
    <div class="hero-badge">📊 Stats Leaders</div>
    <h1>Season <span class="highlight">Leaders</span></h1>
    <p>Top performers across batting and bowling</p>
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <% const latest = data.seasons.find(s => s.status === 'Active') || data.seasons[data.seasons.length - 1]; %>
  <% const stats = latest ? latest.stats : null; %>
  <% if (!latest || !stats) { %>
    <p style="text-align:center;color:var(--text-light)">No season data available.</p>
  <% } else {
    const runsList = (stats.topRunScorers || []);
    const wktsList = (stats.topWicketTakers || []);

    function playerLink(name) {
      const p = data.players.find(x => x.name === name);
      return p ? '<a href="/player/' + p.id + '" style="color:var(--text)">' + name + '</a>' : '<span style="color:var(--text)">' + name + '</span>';
    }
    function teamCell(team) {
      const t = data.teams.find(x => x.name === team);
      return t ? '<img src="' + t.logoUrl + '" class="table-logo" style="width:18px;height:18px;vertical-align:middle;margin-right:4px" onerror="this.style.display=\'none\'">' + team : team;
    }
  %>

    <div class="section-title">
      <h2><%= latest.name %> <span class="highlight">Leaders</span></h2>
      <p>Top performers in the current season</p>
    </div>

    <!-- TOP RUN SCORERS -->
    <div class="format-card stats-card stats-card-wide" style="max-width:860px;margin:0 auto 2rem">
      <h3>🏏 Most Runs</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Runs</th><th>Avg</th><th>SR</th><th>HS</th></tr></thead>
        <tbody>
          <% if (runsList.length > 0) { runsList.slice(0, 10).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td><%= p.avg %></td>
              <td><%= p.sr %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="9" class="stats-empty-row">No data yet — fills as matches are scored</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- TOP WICKET TAKERS -->
    <div class="format-card stats-card stats-card-wide" style="max-width:860px;margin:0 auto">
      <h3>🎯 Most Wickets</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Wkts</th><th>Runs</th><th>Econ</th><th>BBI</th></tr></thead>
        <tbody>
          <% if (wktsList.length > 0) { wktsList.slice(0, 10).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
              <td><%= p.runs %></td>
              <td><%= p.eco %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="9" class="stats-empty-row">No data yet — fills as matches are scored</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- ====== TEMP DESIGN: MAN OF THE MATCH ====== -->
    <div class="section-title" style="margin-top:4rem">
      <h2>⭐ Man of the <span class="highlight">Match</span></h2>
      <p>Best performer in each match — full scorecard breakdown (temporary preview)</p>
    </div>
    <%
      const motmSampleDays = [
        { date: 'Thursday, Sep 10', items: [
          { match: 'Match 1', name: 'Sample Player A', team: 'Haripur', runs: 41, fours: 3, sixes: 2, wkts: 0, ct: 1, pts: 68 },
          { match: 'Match 2', name: 'Sample Player B', team: 'Abbottabad', runs: 12, fours: 0, sixes: 1, wkts: 3, ct: 0, pts: 52 },
        ]},
        { date: 'Saturday, Sep 12', items: [
          { match: 'Match 3', name: 'Sample Player C', team: 'Mansehra', runs: 35, fours: 2, sixes: 0, wkts: 2, ct: 1, pts: 77 },
          { match: 'Match 4', name: 'Sample Player D', team: 'Muzaffarabad', runs: 28, fours: 4, sixes: 0, wkts: 1, ct: 2, pts: 55 },
        ]},
      ];
    %>
    <% motmSampleDays.forEach(day => { %>
      <div class="motm-table-wrap" style="max-width:860px;margin:0 auto 1.2rem">
        <div class="motm-table-date"><%= day.date %></div>
        <table class="standings-table motm-table">
          <thead><tr><th>#</th><th>Match</th><th>Player</th><th>★</th><th>Runs</th><th>4s</th><th>6s</th><th>Wkts</th><th>Ct</th><th>Pts</th></tr></thead>
          <tbody>
            <% day.items.forEach((mo, mi) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= mi + 1 %></td>
                <td><%= mo.match %></td>
                <td><span class="motm-name">⭐ <%= mo.name %></span><br><span class="motm-team"><%= mo.team %></span></td>
                <td>⭐</td>
                <td><%= mo.runs %></td>
                <td><%= mo.fours %></td>
                <td style="color:var(--gold)"><%= mo.sixes %></td>
                <td style="color:var(--accent)"><%= mo.wkts %></td>
                <td><%= mo.ct %></td>
                <td style="font-weight:800;color:var(--gold)"><%= mo.pts %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>

    <!-- ====== TEMP DESIGN: PLAYER OF THE SEASON ====== -->
    <div class="section-title" style="margin-top:4rem">
      <h2>🌟 Player of the <span class="highlight">Season</span></h2>
      <p>Top performer of the season — shown only after all matches are complete (temporary preview)</p>
    </div>
    <div class="format-card" style="max-width:760px;margin:0 auto;text-align:center;padding:2rem">
      <div class="potm-head">
        <span class="potm-title">🏆 Player of the Season</span>
      </div>
      <div class="potm-name" style="margin-top:0.6rem">🌟 Sample Player A</div>
      <div class="potm-team">Haripur</div>
      <div class="potm-stats-grid">
        <div class="stat"><div class="stat-val" style="font-weight:800;color:var(--gold)">245</div><div class="stat-lbl" style="font-size:0.75rem;color:var(--text-light)">Points</div></div>
        <div class="stat"><div class="stat-val" style="font-weight:800;color:var(--gold)">168</div><div class="stat-lbl" style="font-size:0.75rem;color:var(--text-light)">Runs</div></div>
        <div class="stat"><div class="stat-val" style="font-weight:800;color:var(--gold)">6</div><div class="stat-lbl" style="font-size:0.75rem;color:var(--text-light)">Sixes</div></div>
        <div class="stat"><div class="stat-val" style="font-weight:800;color:var(--gold)">4</div><div class="stat-lbl" style="font-size:0.75rem;color:var(--text-light)">Wickets</div></div>
        <div class="stat"><div class="stat-val" style="font-weight:800;color:var(--gold)">2</div><div class="stat-lbl" style="font-size:0.75rem;color:var(--text-light)">MOTM</div></div>
        <div class="stat"><div class="stat-val" style="font-weight:800;color:var(--gold)">5</div><div class="stat-lbl" style="font-size:0.75rem;color:var(--text-light)">Matches</div></div>
      </div>
    </div>

    <div style="max-width:760px;margin:1.5rem auto 0;text-align:center">
      <p style="color:var(--text-light);font-size:0.85rem">Points scheme: 1 per run · +1 four · +2 six · +10 fifty · +25 hundred · +25 wicket · +8 catch/run-out/stumping</p>
      <p style="color:var(--accent);font-size:0.78rem;font-weight:600;margin-top:0.5rem">🛠 TEMPORARY — bata dein kaise laga, phir main delete kar doonga (aap ke points scheme batao to wohi use ho)</p>
    </div>
    <!-- ====== END TEMP DESIGN ====== -->

  <% } %>
</section>

<%- include('partials/footer', { active: 'leaders' }) %>