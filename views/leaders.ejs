<%- include('partials/header', { active: 'leaders', pageTitle: 'Leaders' }) %>

<section class="hero" style="min-height:35vh">
  <div class="hero-content">
    <div class="hero-badge">📊 Stats Leaders</div>
    <h1>Season <span class="highlight">Leaders</span></h1>
    <p>Top performers across batting and bowling</p>
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <% const latest = data.seasons.find(s => s.status === 'Active') || data.seasons[data.seasons.length - 1]; %>
  <% const stats = latest ? latest.stats : null; %>
  <% if (!latest || !stats) { %>
    <p style="text-align:center;color:var(--text-light)">No season data available.</p>
  <% } else {
    const runsList = (stats.topRunScorers || []);
    const wktsList = (stats.topWicketTakers || []);

    function playerLink(name) {
      const p = data.players.find(x => x.name === name);
      return p ? '<a href="/player/' + p.id + '" style="color:var(--text)">' + name + '</a>' : '<span style="color:var(--text)">' + name + '</span>';
    }
    function teamCell(team) {
      const t = data.teams.find(x => x.name === team);
      return t ? '<img src="' + t.logoUrl + '" class="table-logo" style="width:18px;height:18px;vertical-align:middle;margin-right:4px" onerror="this.style.display=\'none\'">' + team : team;
    }
  %>

    <div class="section-title">
      <h2><%= latest.name %> <span class="highlight">Leaders</span></h2>
      <p>Top performers in the current season</p>
    </div>

    <!-- TOP RUN SCORERS -->
    <div class="format-card stats-card stats-card-wide" style="max-width:860px;margin:0 auto 2rem">
      <h3>🏏 Most Runs</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Runs</th><th>Avg</th><th>SR</th><th>HS</th></tr></thead>
        <tbody>
          <% if (runsList.length > 0) { runsList.slice(0, 10).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td><%= p.avg %></td>
              <td><%= p.sr %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="9" class="stats-empty-row">No data yet — fills as matches are scored</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- TOP WICKET TAKERS -->
    <div class="format-card stats-card stats-card-wide" style="max-width:860px;margin:0 auto">
      <h3>🎯 Most Wickets</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Wkts</th><th>Runs</th><th>Econ</th><th>BBI</th></tr></thead>
        <tbody>
          <% if (wktsList.length > 0) { wktsList.slice(0, 10).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
              <td><%= p.runs %></td>
              <td><%= p.eco %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="9" class="stats-empty-row">No data yet — fills as matches are scored</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- ====== TEMPORARY PREVIEW: MOTM & POTM FORMAT ====== -->
    <div style="max-width:860px;margin:3.5rem auto 0;padding:1.2rem 1.4rem;border:2px dashed #f5c518;border-radius:14px;background:rgba(245,197,24,0.06)">
      <div style="text-align:center;font-weight:800;color:var(--gold);letter-spacing:1px;text-transform:uppercase;font-size:0.8rem;margin-bottom:1.4rem">🛠 Temporary Preview — how MOTM & Player of the Season will look (sample)</div>

      <h3 style="margin-bottom:0.6rem;font-size:1rem;color:var(--text-light)">⭐ Man of the Match (per match)</h3>
      <div class="motm-grid" style="max-width:760px;margin:0 0 2rem">
        <div class="motm-card">
          <div class="motm-head"><span class="motm-match">Match 1</span><span class="motm-pts">68 pts</span></div>
          <div class="motm-player"><span class="motm-name">⭐ Sample Player A</span><span class="motm-team">Haripur</span></div>
          <div class="motm-line">41 runs</div>
        </div>
        <div class="motm-card">
          <div class="motm-head"><span class="motm-match">Match 2</span><span class="motm-pts">52 pts</span></div>
          <div class="motm-player"><span class="motm-name">⭐ Sample Player B</span><span class="motm-team">Abbottabad</span></div>
          <div class="motm-line">3 wickets</div>
        </div>
        <div class="motm-card">
          <div class="motm-head"><span class="motm-match">Match 3</span><span class="motm-pts">77 pts</span></div>
          <div class="motm-player"><span class="motm-name">⭐ Sample Player C</span><span class="motm-team">Mansehra</span></div>
          <div class="motm-line">35 runs · 2 wickets</div>
        </div>
      </div>

      <h3 style="margin-bottom:0.6rem;font-size:1rem;color:var(--text-light)">🌟 Player of the Season</h3>
      <div class="potm-hero" style="max-width:760px;margin:0 auto">
        <div class="potm-hero-name">🌟 Sample Player A</div>
        <div class="potm-hero-team">Haripur</div>
        <div class="potm-hero-stats">
          <div class="potm-stat"><span class="potm-sv">245</span><span class="potm-sl">Points</span></div>
          <div class="potm-stat"><span class="potm-sv">168</span><span class="potm-sl">Runs</span></div>
          <div class="potm-stat"><span class="potm-sv">2</span><span class="potm-sl">MOTM</span></div>
          <div class="potm-stat"><span class="potm-sv">5</span><span class="potm-sl">Matches</span></div>
        </div>
      </div>

      <p style="text-align:center;color:var(--text-light);font-size:0.8rem;margin-top:1.4rem">Points: 1/run · +1/four · +2/six · +10/fifty · +25/hundred · +25/wicket · +8/catch, run-out or stumping</p>
    </div>
    <!-- ====== END TEMPORARY PREVIEW ====== -->

  <% } %>
</section>

<%- include('partials/footer', { active: 'leaders' }) %>