<%- include('partials/header', { active: 'leaders', pageTitle: 'Leaders' }) %>

<section class="hero" style="min-height:35vh">
  <div class="hero-content">
    <div class="hero-badge">📊 Stats Leaders</div>
    <h1>Season <span class="highlight">Leaders</span></h1>
    <p>Top performers across batting and bowling categories</p>
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <% const latest = data.seasons.find(s => s.status === 'Active') || data.seasons[data.seasons.length - 1]; %>
  <% const stats = latest ? latest.stats : null; %>
  <% if (!latest || !stats) { %>
    <p style="text-align:center;color:var(--text-light)">No season data available.</p>
  <% } else {
    const runsList = (stats.topRunScorers || []);
    const wktsList = (stats.topWicketTakers || []);
    const byFours = runsList.slice().sort((a, b) => b.fours - a.fours);
    const bySixes = runsList.slice().sort((a, b) => b.sixes - a.sixes);
    const bySr = runsList.slice().sort((a, b) => parseFloat(b.sr) - parseFloat(a.sr));
    const byAvg = runsList.slice().sort((a, b) => parseFloat(b.avg) - parseFloat(a.avg));
    const byEco = wktsList.slice().sort((a, b) => parseFloat(a.eco) - parseFloat(b.eco));
    const byBowlingSr = wktsList.slice().sort((a, b) => parseFloat(a.sr) - parseFloat(b.sr) || b.wickets - a.wickets);
    const byBowling = wktsList.slice().sort((a, b) => b.wickets - a.wickets || parseFloat(a.avg) - parseFloat(b.avg));
    const byFifties = runsList.filter(p => (p.fifties || 0) > 0).sort((a, b) => b.fifties - a.fifties);
    const byCenturies = runsList.filter(p => (p.hundreds || 0) > 0).sort((a, b) => b.hundreds - a.hundreds);

    function playerLink(name) {
      const p = data.players.find(x => x.name === name);
      return p ? '<a href="/player/' + p.id + '" style="color:var(--text)">' + name + '</a>' : '<span style="color:var(--text)">' + name + '</span>';
    }
    function teamCell(team) {
      const t = data.teams.find(x => x.name === team);
      return t ? '<img src="' + t.logoUrl + '" class="table-logo" style="width:18px;height:18px;vertical-align:middle;margin-right:4px" onerror="this.style.display=\'none\'">' + team : team;
    }
  %>

    <div class="section-title">
      <h2><%= latest.name %> <span class="highlight">Leaders</span></h2>
      <p>Top performers in the current season</p>
    </div>

    <!-- BATTING LEADERS -->
    <div class="stats-section-header"><span>🏏</span> Batting Leaders</div>
    <div class="stats-grid">

      <div class="format-card stats-card stats-card-wide">
        <h3>Top Run Scorers</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Runs</th><th>Avg</th><th>SR</th><th>Best</th></tr></thead>
          <tbody>
            <% if (runsList.length > 0) { runsList.slice(0, 10).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.matches || 0 %></td>
                <td><%= p.innings || 0 %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
                <td><%= p.avg %></td>
                <td><%= p.sr %></td>
                <td><%= p.best %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="9" class="stats-empty-row">No batting data yet — leaderboard fills as matches are scored</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>📊 Best Batting Average</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>Avg</th></tr></thead>
          <tbody>
            <% if (byAvg.length > 0) { byAvg.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.avg %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>⚡ Best Strike Rate</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>SR</th></tr></thead>
          <tbody>
            <% if (bySr.length > 0) { bySr.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.runs %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.sr %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>4️⃣ Most Fours</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>4s</th></tr></thead>
          <tbody>
            <% if (byFours.length > 0) { byFours.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.runs %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.fours %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>💣 Most Sixes</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>6s</th></tr></thead>
          <tbody>
            <% if (bySixes.length > 0) { bySixes.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.runs %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.sixes %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>

    <!-- BOWLING LEADERS -->
    <div class="stats-section-header"><span>🎯</span> Bowling Leaders</div>
    <div class="stats-grid">

      <div class="format-card stats-card stats-card-wide">
        <h3>Top Wicket Takers</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Wkts</th><th>Runs</th><th>Avg</th><th>Econ</th><th>SR</th><th>Best</th></tr></thead>
          <tbody>
            <% if (wktsList.length > 0) { wktsList.slice(0, 10).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.matches || 0 %></td>
                <td><%= p.innings || 0 %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
                <td><%= p.runs %></td>
                <td><%= p.avg %></td>
                <td><%= p.eco %></td>
                <td><%= p.sr %></td>
                <td><%= p.best %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="11" class="stats-empty-row">No bowling data yet — leaderboard fills as matches are scored</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>🏅 Best Bowling Figures</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Wkts</th><th>Best</th></tr></thead>
          <tbody>
            <% if (byBowling.length > 0) { byBowling.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
                <td><%= p.best %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>🛡️ Best Economy Rate</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Wkts</th><th>Econ</th></tr></thead>
          <tbody>
            <% if (byEco.length > 0) { byEco.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.wickets %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.eco %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>⚡ Best Bowling Strike Rate</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Wkts</th><th>SR</th></tr></thead>
          <tbody>
            <% if (byBowlingSr.length > 0) { byBowlingSr.slice(0, 5).forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td><%= p.wickets %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.sr %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="5" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>

    <!-- MILESTONES -->
    <div class="stats-section-header"><span>🏆</span> Milestones</div>
    <div class="stats-grid">

      <div class="format-card stats-card">
        <h3>💯 Most Centuries</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>Avg</th><th>100s</th></tr></thead>
          <tbody>
            <% if (byCenturies.length > 0) { byCenturies.forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
                <td><%= p.avg %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.hundreds %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="6" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="format-card stats-card">
        <h3>50️⃣ Most Fifties</h3>
        <table class="standings-table compact-table">
          <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>Avg</th><th>50s</th></tr></thead>
          <tbody>
            <% if (byFifties.length > 0) { byFifties.forEach((p, i) => { %>
              <tr>
                <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
                <td><%- playerLink(p.player) %></td>
                <td><%- teamCell(p.team) %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
                <td><%= p.avg %></td>
                <td style="font-weight:700;color:var(--accent)"><%= p.fifties %></td>
              </tr>
            <% }) } else { %>
              <tr><td colspan="6" class="stats-empty-row">—</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  <% } %>
</section>

<%- include('partials/footer', { active: 'leaders' }) %>