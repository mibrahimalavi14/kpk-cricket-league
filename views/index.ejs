<%- include('partials/header', { active: 'home', pageTitle: 'Home' }) %>

<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">🏏 <%= data.tournament.season %> - <%= data.tournament.year %> | T<%= data.tournament.overs %></div>
    <h1>Welcome to <span class="highlight"><%= data.tournament.name %></span></h1>
    <p><%= data.tournament.description %></p>
    <div class="hero-buttons">
      <a href="/seasons" class="btn btn-primary">View Seasons</a>
      <a href="/teams" class="btn btn-outline">Meet the Teams</a>
      <a href="/players" class="btn btn-gold">Star Players</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-title">
    <h2>Featured <span class="highlight">Teams</span></h2>
    <p>Five powerhouse teams competing for the ultimate glory</p>
  </div>
  <div class="teams-grid">
    <% const activeSeason = data.seasons.find(s => s.status === 'Active') || data.seasons[0]; %>
    <% data.teams.forEach(team => {
      const ptRow = activeSeason && activeSeason.pointsTable ? activeSeason.pointsTable.find(p => p.team === team.name) : null; %>
      <a href="/team/<%= team.id %>" class="team-card">
        <div style="position:absolute;top:0;left:0;right:0;height:4px;background:<%= team.color %>"></div>
        <div class="team-logo"><img src="<%= team.logoUrl %>" alt="<%= team.name %>" class="team-logo-img" onerror="this.style.display='none'"></div>
        <h3><%= team.name %></h3>
        <div class="team-city">📍 <%= team.city %></div>
        <div class="team-captain">⭐ Captain: <%= team.captain %></div>
        <div class="team-stats">
          <div class="stat"><div class="stat-val"><%= ptRow ? ptRow.played : 0 %></div><div class="stat-label">Played</div></div>
          <div class="stat"><div class="stat-val"><%= ptRow ? ptRow.won : 0 %></div><div class="stat-label">Won</div></div>
          <div class="stat"><div class="stat-val"><%= ptRow ? ptRow.points : 0 %></div><div class="stat-label">Points</div></div>
        </div>
      </a>
    <% }) %>
  </div>
</section>

<section class="section" style="background:rgba(0,0,0,0.2)">
  <div class="section-title">
    <h2>Current Season <span class="highlight">Overview</span></h2>
    <p><%= activeSeason.name %> - <%= activeSeason.year %> | T<%= activeSeason.overs %> format</p>
  </div>
  <div style="display:flex;justify-content:center;gap:2rem;flex-wrap:wrap;max-width:1000px;margin:0 auto">
    <div class="stat-card" style="text-align:center;min-width:180px">
      <div class="sc-label">Teams</div>
      <div class="sc-value"><%= data.teams.length %></div>
      <div class="sc-sub">Competing for glory</div>
    </div>
    <div class="stat-card" style="text-align:center;min-width:180px">
      <div class="sc-label">Overs per Match</div>
      <div class="sc-value"><%= activeSeason.overs %></div>
      <div class="sc-sub">Fast-paced T<%= activeSeason.overs %> action</div>
    </div>
    <div class="stat-card" style="text-align:center;min-width:180px">
      <div class="sc-label">League Matches</div>
      <div class="sc-value"><%= activeSeason.matches ? activeSeason.matches.length : 0 %></div>
      <div class="sc-sub">Round-robin fixtures</div>
    </div>
    <div class="stat-card" style="text-align:center;min-width:180px">
      <div class="sc-label">Players</div>
      <div class="sc-value"><%= data.players.length %></div>
      <div class="sc-sub">Elite athletes</div>
    </div>
  </div>
  <div style="text-align:center;margin-top:2rem">
    <a href="/season/<%= activeSeason.id %>" class="btn btn-primary">View Season Details</a>
  </div>
</section>

<%
  const latestSeason = data.seasons.find(s => s.status === 'Active') || data.seasons[data.seasons.length - 1];
  const ts = {};
  data.teams.forEach(t => { ts[t.name] = { m: 0, runs: 0, wkts: 0, fours: 0, sixes: 0 }; });
  [].concat(latestSeason.matches || [], latestSeason.playoff || []).forEach(mx => {
    if (mx.status === 'upcoming') return;
    if (!mx.inn1 || mx.inn1.legalBalls === 0) return;
    ts[mx.team1].m++; ts[mx.team2].m++;
    ts[mx.team1].runs += mx.inn1.runs;
    ts[mx.team1].fours += (mx.inn1.batting || []).reduce((s, b) => s + (b.fours || 0), 0);
    ts[mx.team1].sixes += (mx.inn1.batting || []).reduce((s, b) => s + (b.sixes || 0), 0);
    ts[mx.team2].wkts += mx.inn1.wickets;
    if (mx.inn2 && mx.inn2.legalBalls > 0) {
      ts[mx.team2].runs += mx.inn2.runs;
      ts[mx.team2].fours += (mx.inn2.batting || []).reduce((s, b) => s + (b.fours || 0), 0);
      ts[mx.team2].sixes += (mx.inn2.batting || []).reduce((s, b) => s + (b.sixes || 0), 0);
      ts[mx.team1].wkts += mx.inn2.wickets;
    }
  });
  const rankedTeams = data.teams.filter(t => ts[t.name].m > 0).sort((a, b) => ts[b.name].runs - ts[a.name].runs);
  const totals = data.teams.reduce((a, t) => {
    const s = ts[t.name] || { m: 0, runs: 0, wkts: 0, fours: 0, sixes: 0 };
    a.m += s.m; a.runs += s.runs; a.wkts += s.wkts; a.fours += s.fours; a.sixes += s.sixes;
    return a;
  }, { m: 0, runs: 0, wkts: 0, fours: 0, sixes: 0 });
  totals.m = Math.round(totals.m / 2);
%>

<section class="section" style="background:rgba(0,0,0,0.2)">
  <div class="section-title">
    <h2><span class="highlight"><%= latestSeason.name %></span> Stats</h2>
    <p><%= latestSeason.year %> · T<%= latestSeason.overs %> · Per-team performance — updates live as matches are scored</p>
  </div>
    <div style="overflow-x:auto">
      <table class="standings-table" style="max-width:820px">
        <thead>
          <tr><th>#</th><th>Team</th><th>M</th><th>Runs</th><th>Wkts</th><th>4s</th><th>6s</th></tr>
        </thead>
        <tbody>
          <% data.teams.map(t => ({ t, s: ts[t.name] || { m: 0, runs: 0, wkts: 0, fours: 0, sixes: 0 } }))
             .sort((a, b) => b.s.runs - a.s.runs)
             .forEach((row, i) => { const t = row.t; const s = row.s; %>
            <tr>
              <td style="font-weight:700;color:var(--gold);width:40px"><%= i + 1 %></td>
              <td>
                <span style="display:inline-flex;align-items:center;gap:0.5rem;font-weight:600">
                  <span style="width:10px;height:10px;border-radius:2px;background:<%= t.color %>"></span>
                  <%= t.name %>
                </span>
              </td>
              <td><%= s.m %></td>
              <td style="font-weight:700;color:var(--accent)"><%= s.runs %></td>
              <td style="font-weight:700;color:#e74c3c"><%= s.wkts %></td>
              <td style="color:#3498db"><%= s.fours %></td>
              <td style="color:var(--gold)"><%= s.sixes %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr style="background:rgba(233,69,96,0.12);font-weight:800">
            <td style="color:var(--gold);width:40px"></td>
            <td>TOTAL</td>
            <td style="color:var(--gold)"><%= totals.m %></td>
            <td style="font-weight:800;color:var(--accent)"><%= totals.runs %></td>
            <td style="font-weight:800;color:#e74c3c"><%= totals.wkts %></td>
            <td style="color:#3498db"><%= totals.fours %></td>
            <td style="color:var(--gold)"><%= totals.sixes %></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div style="text-align:center;margin-top:1.5rem">
      <a href="/season/<%= latestSeason.id %>" class="btn btn-primary">View Full Season</a>
    </div>
</section>

<%- include('partials/footer') %>