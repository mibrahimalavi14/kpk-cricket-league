<%- include('partials/header', { active: 'awards', pageTitle: 'Awards' }) %>

<section class="hero" style="min-height:35vh">
  <div class="hero-content">
    <div class="hero-badge">🏆 Awards</div>
    <h1><span class="highlight">Awards</span> & Honours</h1>
    <p>Man of the Match & Player of the Season across all seasons</p>
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <div class="award-tabs">
    <a href="/awards#motm" class="award-tab <%= (typeof tab !== 'undefined' && tab === 'motm') || (typeof tab === 'undefined') ? 'active' : '' %>" data-tab="motm">Man of the Match</a>
    <a href="/awards#potm" class="award-tab <%= typeof tab !== 'undefined' && tab === 'potm' ? 'active' : '' %>" data-tab="potm">Player of the Season</a>
  </div>

  <!-- MOTM Tab -->
  <div id="motm-section" class="award-section" style="<%= typeof tab !== 'undefined' && tab === 'potm' ? 'display:none' : '' %>">
    <% const reversedSeasons = data.seasons.slice().reverse(); %>
    <% reversedSeasons.forEach((s, si) => { const motmList = (s.motms || []).filter(m => m && m.name); %>
      <div class="season-accordion">
        <button class="accordion-toggle <%= si === 0 ? 'open' : '' %>" onclick="toggleAcc(this)">
          <span class="acc-title">
            <span class="acc-icon"><%= si === 0 ? '▾' : '▸' %></span>
            <%= s.name %> — <%= s.year %>
            <span class="acc-count"><%= motmList.length %> MOTM<%= motmList.length !== 1 ? 's' : '' %></span>
          </span>
        </button>
        <div class="accordion-body" style="<%= si === 0 ? 'display:block' : 'display:none' %>">
          <% if (motmList.length === 0) { %>
            <p style="color:var(--text-light);text-align:center;padding:1.5rem 0">No matches completed yet in this season.</p>
          <% } else { %>
            <%
              // group MOTM cards by date (like the schedule: 2 matches per day)
              const motmByDate = {};
              motmList.forEach(mo => { const d = mo.date || 'TBA'; if (!motmByDate[d]) motmByDate[d] = []; motmByDate[d].push(mo); });
              const motmDates = Object.keys(motmByDate).sort();
            %>
            <% motmDates.forEach(dt => { %>
              <div class="motm-table-wrap">
                <div class="motm-table-date"><%= dt %></div>
                <table class="standings-table motm-table">
                  <thead><tr><th>#</th><th>Match</th><th>Player</th><th>★</th><th>Runs</th><th>4s</th><th>6s</th><th>Wkts</th><th>Ct</th><th>Pts</th></tr></thead>
                  <tbody>
                    <% motmByDate[dt].forEach((mo, mi) => { %>
                      <tr>
                        <td style="font-weight:700;color:var(--gold)"><%= mi + 1 %></td>
                        <td><%= mo.match %></td>
                        <td><span class="motm-name">⭐ <%= mo.name %></span><br><span class="motm-team"><%= mo.team %></span></td>
                        <td>⭐</td>
                        <td><%= mo.runs || 0 %></td>
                        <td><%= mo.fours || 0 %></td>
                        <td style="color:var(--gold)"><%= mo.sixes || 0 %></td>
                        <td style="color:var(--accent)"><%= mo.wickets || 0 %></td>
                        <td><%= mo.catches || 0 %></td>
                        <td style="font-weight:800;color:var(--gold)"><%= mo.points || 0 %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- POTM Tab -->
  <div id="potm-section" class="award-section" style="<%= typeof tab !== 'undefined' && tab === 'potm' ? '' : 'display:none' %>">
    <% reversedSeasons.forEach((s, si) => { const potm = s.playerOfSeason; %>
      <div class="season-accordion">
        <button class="accordion-toggle <%= si === 0 ? 'open' : '' %>" onclick="toggleAcc(this)">
          <span class="acc-title">
            <span class="acc-icon"><%= si === 0 ? '▾' : '▸' %></span>
            <%= s.name %> — <%= s.year %>
          </span>
        </button>
        <div class="accordion-body" style="<%= si === 0 ? 'display:block' : 'display:none' %>">
          <% if (!potm) { %>
            <p style="color:var(--text-light);text-align:center;padding:1.5rem 0">Not decided yet — player of the season will be chosen once matches are scored.</p>
          <% } else { %>
            <div class="potm-hero">
              <div class="potm-hero-name">🌟 <%= potm.player %></div>
              <div class="potm-hero-team"><%= potm.team %></div>
              <div class="potm-hero-stats">
                <div class="potm-stat"><span class="potm-sv"><%= potm.points %></span><span class="potm-sl">Points</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.runs %></span><span class="potm-sl">Runs</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.fours || 0 %></span><span class="potm-sl">Fours</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.sixes || 0 %></span><span class="potm-sl">Sixes</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.wickets || 0 %></span><span class="potm-sl">Wickets</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.catches || 0 %></span><span class="potm-sl">Catches</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.motmAwards %></span><span class="potm-sl">MOTM</span></div>
                <div class="potm-stat"><span class="potm-sv"><%= potm.matches %></span><span class="potm-sl">Matches</span></div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<script>
function toggleAcc(btn) {
  const body = btn.nextElementSibling;
  const isOpen = btn.classList.contains('open');
  btn.classList.toggle('open');
  btn.querySelector('.acc-icon').textContent = isOpen ? '▸' : '▾';
  body.style.display = isOpen ? 'none' : 'block';
}

function applyAwardTab(hash) {
  var motmSec = document.getElementById('motm-section');
  var potmSec = document.getElementById('potm-section');
  var tabs = document.querySelectorAll('.award-tab');
  if (hash === 'potm') {
    motmSec.style.display = 'none';
    potmSec.style.display = '';
    tabs.forEach(function (t) { t.classList.remove('active'); });
    if (tabs[1]) tabs[1].classList.add('active');
  } else {
    potmSec.style.display = 'none';
    motmSec.style.display = '';
    tabs.forEach(function (t) { t.classList.remove('active'); });
    if (tabs[0]) tabs[0].classList.add('active');
  }
}

document.addEventListener('DOMContentLoaded', function () {
  applyAwardTab(window.location.hash.replace('#', ''));
});
window.addEventListener('hashchange', function () {
  applyAwardTab(window.location.hash.replace('#', ''));
});
</script>

<%- include('partials/footer', { active: 'awards' }) %>