<%- include('partials/header', { active: 'live', pageTitle: 'Live' }) %>

<section class="hero" style="min-height:35vh">
  <div class="hero-content">
    <div class="hero-badge"><span class="live-dot" style="display:inline-block;vertical-align:middle;margin-right:6px"></span> Live Scoring</div>
    <h1>Live <span class="highlight">Matches</span></h1>
    <p>Matches in progress — results publish the moment a match finishes</p>
  </div>
</section>

<section class="section" style="padding-top:3rem">
  <% if (liveMatches.length === 0) { %>
    <div class="format-card" style="text-align:center;padding:3rem">
      <div style="font-size:3rem;margin-bottom:1rem">📡</div>
      <h3 style="margin-bottom:0.5rem">No Live Matches Right Now</h3>
      <p style="color:var(--text-light)">Live scoring will appear here as soon as a match starts.</p>
      <div style="margin-top:1.5rem"><a href="/fixtures" class="btn btn-primary">View Fixtures</a></div>
    </div>
  <% } else { %>
    <p style="text-align:center;color:var(--text-light);margin-bottom:2rem">This page updates automatically — results appear here as soon as each match is completed</p>
  <% } %>

  <div id="live-matches" class="teams-grid">
    <% liveMatches.forEach(m => { %>
      <div class="match-card live-match-card" data-matchid="<%= m.id %>">
        <div class="match-info">
          <div class="match-label"><%= m.match %> <span style="color:var(--text-light);font-weight:400">· <%= m.seasonName %></span></div>          <div class="match-teams">
            <span class="match-team"><%= m.team1 %></span>
            <span class="vs">vs</span>
            <span class="match-team"><%= m.team2 %></span>
          </div>
          <div class="live-scores">
            <div class="live-score-row">
              <span class="ls-team"><%= m.team1 %></span>
              <span class="ls-overs">Score hidden</span>
            </div>
            <div class="live-score-row">
              <span class="ls-team"><%= m.team2 %></span>
              <span class="ls-overs">Score hidden</span>
            </div>
          </div>
          <p style="color:var(--text-light);font-size:0.85rem;margin:0.75rem 0 0">Live score is kept private. The scorecard, statistics and awards are published here automatically once the match finishes.</p>
          <a href="/match/<%= m.id %>" class="btn btn-sm btn-primary" style="margin-top:1rem">Match Details →</a>
        </div>
        <span class="match-status live-badge"><span class="live-dot"></span> LIVE</span>
      </div>
    <% }) %>
  </div>
</section>

<script>
(function () {
  var container = document.getElementById('live-matches');
  if (!container) return;
  function currentKeys() {
    return [].slice.call(container.querySelectorAll('.live-match-card'))
      .map(function (c) { return c.getAttribute('data-matchid'); })
      .sort().join(',');
  }
  var known = currentKeys();
  setInterval(function () {
    fetch('/api/live', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (res) {
        var now = (res.live || []).map(function (m) { return String(m.id); }).sort().join(',');
        if (now !== known) location.reload();
      }).catch(function () {});
  }, 3000);
})();
</script>

<%- include('partials/footer', { active: 'live' }) %>