<%- include('partials/header', { active: 'fixtures', pageTitle: 'Fixtures' }) %>

<section class="hero" style="min-height:40vh">
  <div class="hero-content">
    <div class="hero-badge">📅 <%= data.tournament.name %> - <%= season.year %></div>
    <h1>Full <span class="highlight">Fixtures</span></h1>
    <p><%= season.name %> | T<%= season.overs %> | <%= season.format %></p>
  </div>
</section>

<section class="section" style="padding-top:3rem">
  <div class="section-title">
    <h2>League <span class="highlight">Matches</span></h2>
    <p>All league games with teams, dates, schedules and results</p>
  </div>
  <div class="match-grid match-grid-single">
    <% (season.matches || []).forEach(match => { %>
      <a href="/match/<%= match.id %>" class="match-card fixture-card">
        <%- include('partials/match_banner', { m: match }) %>
      </a>
    <% }) %>
  </div>

  <% if (season.playoff && season.playoff.length > 0) { %>
    <div class="section-title" style="margin-top:4rem">
      <h2>Playoffs & <span class="highlight">Final</span></h2>
      <p>Knockout matches and the Grand Final</p>
    </div>
    <div class="match-grid match-grid-single">
      <% season.playoff.forEach(match => { %>
        <a href="/match/<%= match.id %>" class="match-card fixture-card">
          <%- include('partials/match_banner', { m: match, playoff: true }) %>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer', { active: 'fixtures' }) %>