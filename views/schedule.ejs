<%- include('partials/header', { active: 'schedule', pageTitle: 'Schedule' }) %>

<section class="hero" style="min-height:35vh">
  <div class="hero-content">
    <div class="hero-badge">📅 Match Schedule</div>
    <h1><%= season.name %> <span class="highlight">Schedule</span></h1>
    <p><%= data.tournament.name %> · T<%= season.overs %> · <%= season.format %></p>
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <%
    const allMatches = (season.matches || []);
    const playoffMatches = (season.playoff || []);

    function fmtDate(d) {
      try {
        const dt = new Date(d + 'T00:00:00');
        return dt.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
      } catch(e) { return d; }
    }
    function fmtDay(d) {
      try {
        const dt = new Date(d + 'T00:00:00');
        return dt.toLocaleDateString('en-US', { weekday: 'long' });
      } catch(e) { return ''; }
    }
    function fmtMD(d) {
      try {
        const dt = new Date(d + 'T00:00:00');
        return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      } catch(e) { return d; }
    }
    function fmtTime(t) {
      if (!t) return 'TBA';
      const parts = t.split(':');
      let h = parseInt(parts[0], 10), m = parts[1] || '00';
      const ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12; if (h === 0) h = 12;
      return h + ':' + m + ' ' + ampm;
    }

    const dateMap = {};
    allMatches.forEach(m => {
      const d = m.date || 'TBA';
      if (!dateMap[d]) dateMap[d] = [];
      dateMap[d].push(m);
    });
    const sortedDates = Object.keys(dateMap).sort();
  %>

  <% if (sortedDates.length === 0 && playoffMatches.length === 0) { %>
    <div class="format-card" style="max-width:640px;margin:0 auto 2rem;text-align:center;padding:2rem">
      <div style="font-size:2.5rem;margin-bottom:0.8rem">📅</div>
      <h3>No fixtures yet</h3>
      <p style="color:var(--text-light)">Match schedule will appear here once fixtures are set.</p>
    </div>
  <% } %>

  <% sortedDates.forEach(date => {
    const matches = dateMap[date];
  %>
    <div class="schedule-day">
      <div class="schedule-day-head">
        <div class="schedule-day-date"><%= fmtDate(date) %></div>
        <div class="schedule-day-meta"><%= matches.length %> match<%= matches.length > 1 ? 'es' : '' %> · <%= fmtDay(date) %></div>
      </div>
      <div class="schedule-fixtures">
        <% matches.forEach(m => { %>
          <div class="schedule-entry">
            <div class="schedule-entry-time">
              <span class="se-time"><%= fmtTime(m.time) %></span>
              <span class="se-venue">📍 <%= m.venue || 'Venue TBA' %></span>
            </div>
            <div class="schedule-entry-match">
              <div class="se-matchlabel"><%= m.match %></div>
              <div class="se-teams">
                <span class="se-team"><%= m.team1 %></span>
                <span class="se-vs">vs</span>
                <span class="se-team"><%= m.team2 %></span>
              </div>
            </div>
            <div class="schedule-entry-day"><%= fmtMD(date) %></div>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <% if (playoffMatches.length > 0) {
    const playoffDateMap = {};
    playoffMatches.forEach(m => {
      const d = m.date || 'TBA';
      if (!playoffDateMap[d]) playoffDateMap[d] = [];
      playoffDateMap[d].push(m);
    });
    const playoffDates = Object.keys(playoffDateMap).sort();
  %>
    <div class="schedule-day" style="margin-top:3rem">
      <div class="schedule-day-head schedule-playoff-head">
        <div class="schedule-day-date" style="color:var(--accent)">⭐ <b><%= season.champion ? 'Playoffs & Grand Final — Champions: ' + season.champion : 'Playoffs & Grand Final' %></b></div>
        <div class="schedule-day-meta"><%= playoffMatches.length %> match<%= playoffMatches.length > 1 ? 'es' : '' %> · Knockout Stage</div>
      </div>
      <% playoffDates.forEach(date => {
        const matches = playoffDateMap[date];
      %>
        <div class="schedule-day-sub"><%= fmtDate(date) %></div>
        <div class="schedule-fixtures">
          <% matches.forEach(m => { %>
            <div class="schedule-entry">
              <div class="schedule-entry-time">
                <span class="se-time"><%= fmtTime(m.time) %></span>
                <span class="se-venue">📍 <%= m.venue || 'Venue TBA' %></span>
              </div>
              <div class="schedule-entry-match">
                <div class="se-matchlabel">⭐ <%= m.match %></div>
                <div class="se-teams">
                  <% if (m.team1 === 'TBD' || m.team2 === 'TBD') { %>
                    <span class="se-team se-tbd">Qualifier teams TBD</span>
                  <% } else { %>
                    <span class="se-team"><%= m.team1 %></span>
                    <span class="se-vs">vs</span>
                    <span class="se-team"><%= m.team2 %></span>
                  <% } %>
                </div>
              </div>
              <div class="schedule-entry-day"><%= fmtMD(date) %></div>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer', { active: 'schedule' }) %>