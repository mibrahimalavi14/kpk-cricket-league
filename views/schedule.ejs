<%- include('partials/header', { active: 'schedule', pageTitle: 'Schedule' }) %>

<section class="hero" style="min-height:50vh;padding:3rem 2rem">
  <div class="hero-content">
    <div class="hero-badge"><%= data.tournament.name %> - <%= season.year %></div>
    <h1>Full <span class="highlight">Schedule</span></h1>
    <p><%= season.name %> | T<%= season.overs %> | <%= season.format %></p>
  </div>
</section>

<section class="section" style="padding-top:3rem">
  <div class="section-title">
    <h2>League <span class="highlight">Matches</span></h2>
    <p>Complete fixture list of all league games</p>
  </div>
  <div class="schedule-container">
    <table class="standings-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Match</th>
          <th>Team 1</th>
          <th>Team 2</th>
          <th>Date</th>
          <th>Time</th>
          <th>Result</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% (season.matches || []).forEach((match, i) => {
          const t1 = data.teams.find(t => t.name === match.team1);
          const t2 = data.teams.find(t => t.name === match.team2);
        %>
          <tr>
            <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
            <td><%= match.match %></td>
            <td>
              <div class="team-name-cell">
                <img src="<%= t1 ? t1.logoUrl : '' %>" alt="<%= match.team1 %>" class="table-logo" onerror="this.style.display='none'">
                <%= match.team1 %>
              </div>
            </td>
            <td>
              <div class="team-name-cell">
                <img src="<%= t2 ? t2.logoUrl : '' %>" alt="<%= match.team2 %>" class="table-logo" onerror="this.style.display='none'">
                <%= match.team2 %>
              </div>
            </td>
            <td><%= match.date %></td>
            <td><%= match.time %></td>
            <td><%= match.result || '—' %></td>
            <td>
              <% if (match.result) { %>
                <span style="color:#2ecc71;font-weight:600">Completed</span>
              <% } else { %>
                <span style="color:#f39c12;font-weight:600">Upcoming</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="section-title" style="margin-top:4rem">
    <h2>Playoffs & <span class="highlight">Final</span></h2>
    <p>Knockout stage fixtures</p>
  </div>
  <div class="schedule-container">
    <table class="standings-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Match</th>
          <th>Team 1</th>
          <th>Team 2</th>
          <th>Date</th>
          <th>Time</th>
          <th>Result</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% (season.playoff || []).forEach((match, i) => {
          const t1 = data.teams.find(t => t.name === match.team1);
          const t2 = data.teams.find(t => t.name === match.team2);
        %>
          <tr>
            <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
            <td style="color:var(--accent);font-weight:600">⭐ <%= match.match %></td>
            <td>
              <div class="team-name-cell">
                <img src="<%= t1 ? t1.logoUrl : '' %>" alt="<%= match.team1 %>" class="table-logo" onerror="this.style.display='none'">
                <%= match.team1 %>
              </div>
            </td>
            <td>
              <div class="team-name-cell">
                <img src="<%= t2 ? t2.logoUrl : '' %>" alt="<%= match.team2 %>" class="table-logo" onerror="this.style.display='none'">
                <%= match.team2 %>
              </div>
            </td>
            <td><%= match.date %></td>
            <td><%= match.time %></td>
            <td><%= match.result || '—' %></td>
            <td>
              <% if (match.result) { %>
                <span style="color:#2ecc71;font-weight:600">Completed</span>
              <% } else { %>
                <span style="color:#f39c12;font-weight:600">Upcoming</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer', { active: 'schedule' }) %>