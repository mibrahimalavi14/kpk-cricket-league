        <tbody>
          <% if (byCenturies.length > 0) { byCenturies.map((p, i) => ({ p, i })).forEach(({ p, i }) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.name) %></td><td class="team-name-cell"><%- teamCell(p.teamName) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td style="font-weight:700;color:var(--accent)"><%= p.centuries %></td></tr>
          <% }) } else { %>
