<%- include('../partials/header', { active: 'seasons', pageTitle: season.name }) %>

<section class="hero" style="min-height:50vh;padding:3rem 2rem">
  <div class="hero-content">
    <div class="hero-badge"><%= season.name %> - <%= season.year %></div>
    <h1><%= season.name %> <span class="highlight">Details</span></h1>
    <p>T<%= season.overs %> Fast Cricket | Format: <%= season.format %></p>
  </div>
</section>

<div class="season-tabs">
  <a href="#points" class="season-tab active" data-tab="points">🏆 Points Table</a>
  <a href="#matches" class="season-tab" data-tab="matches">📅 Matches</a>
  <a href="#playoff" class="season-tab" data-tab="playoff">🏅 Playoffs</a>
  <a href="#stats" class="season-tab" data-tab="stats">📊 Stats</a>
</div>

<section class="section season-tab-content" id="points-content">
  <div class="section-title"><h2>Points <span class="highlight">Table</span></h2></div>
  <% if (season.pointsTable && season.pointsTable.length > 0) { %>
    <table class="standings-table pt-full">
      <thead>
        <tr>
          <th>#</th>
          <th>Tm</th>
          <th>Played</th>
          <th>Won</th>
          <th>Lost</th>
          <th>Tied</th>
          <th>Points</th>
          <th>NRR</th>
          <th class="th-status">Status</th>
        </tr>
      </thead>
      <tbody>
        <% season.pointsTable.slice().sort((a, b) => b.points - a.points || parseFloat(b.nrr) - parseFloat(a.nrr)).forEach((s, i) => {
          const teamData = data.teams.find(t => t.name === s.team);
          const pos = i + 1;
          const qualified = pos <= 3;
          const medal = qualified && pos <= 3 ? (pos === 1 ? '🥇' : pos === 2 ? '🥈' : '🥉') : '';
          const medalCls = pos === 1 ? 'medal-gold' : pos === 2 ? 'medal-silver' : 'medal-bronze';
        %>
          <tr class="<%= qualified ? 'row-qualified' : 'row-eliminated' %>">
            <td class="rank-medal <%= qualified ? medalCls : '' %>" style="font-weight:700;color:var(--gold)"><%= medal ? medal : pos %></td>
            <td>
              <div class="team-name-cell">
                <img src="<%= teamData ? teamData.logoUrl : '' %>" alt="<%= s.team %>" class="table-logo" onerror="this.style.display='none'">
                <a href="/team/<%= teamData ? teamData.id : '#' %>" style="color:var(--text)"><%= s.team %></a>
              </div>
            </td>
            <td><%= s.played %></td>
            <td style="color:#2ecc71"><%= s.won %></td>
            <td style="color:#e74c3c"><%= s.lost %></td>
            <td><%= s.tied %></td>
            <td style="font-weight:700;color:var(--gold)"><%= s.points %></td>
            <td style="color:<%= parseFloat(s.nrr) >= 0 ? '#2ecc71' : '#e74c3c' %>"><%= s.nrr %></td>
            <td>
              <span class="status-badge <%= qualified ? 'badge-qualified' : 'badge-eliminated' %>"><%= qualified ? 'QUALIFIED' : 'ELIMINATED' %></span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div style="max-width:640px;margin:1.5rem auto 0;text-align:center;padding:0.7rem 1.2rem;background:rgba(46,204,113,0.10);border:1px solid rgba(46,204,113,0.30);border-radius:12px">
      <strong style="color:#2ecc71;font-size:0.85rem;letter-spacing:0.5px">🏆 Top 3 teams qualify for the playoffs</strong>
    </div>
  <% } else { %>
    <p style="text-align:center;color:var(--text-light)">Points table not available yet.</p>
  <% } %>
</section>

<section class="section season-tab-content" id="matches-content" style="display:none">
  <div class="section-title"><h2>League <span class="highlight">Matches</span></h2></div>
  <div class="match-grid match-grid-single">
    <% if (season.matches && season.matches.length > 0) { %>
      <% season.matches.forEach(match => { %>
        <a href="/match/<%= match.id %>" class="match-card fixture-card">
          <%- include('../partials/match_banner', { m: match, season: season }) %>
        </a>
      <% }) %>
    <% } else { %>
      <p style="text-align:center;color:var(--text-light)">No matches scheduled yet.</p>
    <% } %>
  </div>
</section>

<section class="section season-tab-content" id="playoff-content" style="display:none">
  <div class="section-title"><h2>Playoffs & <span class="highlight">Final</span></h2></div>
  <% if (!((season.matches || []).every(m => m.status === 'completed'))) { %>
    <div class="format-card" style="text-align:center;padding:2rem;max-width:640px;margin:0 auto 2rem">
      <div style="font-size:2.5rem;margin-bottom:0.8rem">🏅</div>
      <h3 style="margin-bottom:0.5rem">Playoff spots lock automatically</h3>
      <p style="color:var(--text-light)">Playoff spots will be filled automatically from the points table once all league matches are completed.</p>
    </div>
  <% } %>
  <div class="match-grid match-grid-single">
    <% if (season.playoff && season.playoff.length > 0) { %>
      <% season.playoff.forEach(match => { %>
        <a href="/match/<%= match.id %>" class="match-card fixture-card">
          <%- include('../partials/match_banner', { m: match, playoff: true, season: season }) %>
        </a>
      <% }) %>
    <% } else { %>
      <p style="text-align:center;color:var(--text-light)">Playoffs not scheduled yet.</p>
    <% } %>
  </div>
</section>

<section class="section season-tab-content" id="stats-content" style="display:none">
  <div class="section-title"><h2>Season <span class="highlight">Stats</span></h2></div>

  <%
    const runsList = (season.stats && season.stats.topRunScorers) || [];
    const wktsList = (season.stats && season.stats.topWicketTakers) || [];
    const byFours = runsList.slice().sort((a, b) => b.fours - a.fours);
    const bySixes = runsList.slice().sort((a, b) => b.sixes - a.sixes);
    const bySr = runsList.slice().sort((a, b) => parseFloat(b.sr) - parseFloat(a.sr));
    const byAvg = runsList.slice().sort((a, b) => parseFloat(b.avg) - parseFloat(a.avg));
    const byEco = wktsList.slice().sort((a, b) => parseFloat(a.eco) - parseFloat(b.eco));
    const byBowling = wktsList.slice().sort((a, b) => b.wickets - a.wickets || parseFloat(a.avg) - parseFloat(b.avg));
    const byFifties = runsList.filter(p => (p.fifties || 0) > 0).sort((a, b) => b.fifties - a.fifties);
    const byCenturies = runsList.filter(p => (p.hundreds || 0) > 0).sort((a, b) => b.hundreds - a.hundreds);
    const byFives = wktsList.filter(p => (p.fiveW || 0) > 0).sort((a, b) => b.fiveW - a.fiveW);

    function teamCell(name) {
      const t = data.teams.find(x => x.name === name);
      const img = t ? '<img src="' + t.logoUrl + '" alt="' + name + '" class="table-logo" onerror="this.style.display=\'none\'">' : '';
      return img + '<span style="color:var(--text-light)">' + name + '</span>';
    }
    function playerLink(name) {
      const pl = data.players.find(x => x.name === name);
      if (pl) return '<a href="/player/' + pl.id + '" style="color:var(--text)">' + name + '</a>';
      return '<span style="color:var(--text)">' + name + '</span>';
    }
  %>

  <!-- BATTING LEADERS -->
  <div class="stats-section-header"><span>🏏</span> Batting Leaders</div>
  <div class="stats-grid">

    <div class="format-card stats-card stats-card-wide">
      <h3>Top Run Scorers</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Runs</th><th>Avg</th><th>SR</th><th>Best</th></tr></thead>
        <tbody>
          <% if (runsList.length > 0) { runsList.slice(0, 10).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td><%= p.avg %></td>
              <td><%= p.sr %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="9" class="stats-empty-row">No batting data yet — leaderboard fills as matches are scored</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>📊 Best Batting Average</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>Avg</th></tr></thead>
        <tbody>
          <% if (byAvg.length > 0) { byAvg.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.avg %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>⚡ Best Strike Rate</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>SR</th></tr></thead>
        <tbody>
          <% if (bySr.length > 0) { bySr.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.runs %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.sr %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>4️⃣ Most Fours</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>4s</th></tr></thead>
        <tbody>
          <% if (byFours.length > 0) { byFours.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.runs %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.fours %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>💣 Most Sixes</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>6s</th></tr></thead>
        <tbody>
          <% if (bySixes.length > 0) { bySixes.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.runs %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.sixes %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

  <!-- BOWLING LEADERS -->
  <div class="stats-section-header"><span>🎯</span> Bowling Leaders</div>
  <div class="stats-grid">

    <div class="format-card stats-card stats-card-wide">
      <h3>Top Wicket Takers</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Wkts</th><th>Avg</th><th>Econ</th><th>Best</th></tr></thead>
        <tbody>
          <% if (wktsList.length > 0) { wktsList.slice(0, 10).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
              <td><%= p.avg %></td>
              <td><%= p.eco %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="9" class="stats-empty-row">No bowling data yet — leaderboard fills as matches are scored</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>🏅 Best Bowling Figures</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Wkts</th><th>Best</th></tr></thead>
        <tbody>
          <% if (byBowling.length > 0) { byBowling.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>🛡️ Best Economy Rate</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Wkts</th><th>Econ</th></tr></thead>
        <tbody>
          <% if (byEco.length > 0) { byEco.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.wickets %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.eco %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>🔥 Most 5-Wicket Hauls</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Wkts</th><th>5W</th></tr></thead>
        <tbody>
          <% if (byFives.length > 0) { byFives.forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.wickets %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.fiveW %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="5" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

  <!-- MILESTONES -->
  <div class="stats-section-header"><span>🏆</span> Milestones</div>
  <div class="stats-grid">

    <div class="format-card stats-card">
      <h3>💯 Most Centuries</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>Avg</th><th>100s</th></tr></thead>
        <tbody>
          <% if (byCenturies.length > 0) { byCenturies.forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td><%= p.avg %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.hundreds %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="6" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="format-card stats-card">
      <h3>50️⃣ Most Fifties</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Player</th><th>Team</th><th>Runs</th><th>Avg</th><th>50s</th></tr></thead>
        <tbody>
          <% if (byFifties.length > 0) { byFifties.forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td><%= p.avg %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.fifties %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="6" class="stats-empty-row">—</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>

</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.season-tab');
    const contents = document.querySelectorAll('.season-tab-content');

    function showTab(tabId) {
      tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));
      contents.forEach(c => { c.style.display = c.id === tabId + '-content' ? 'block' : 'none'; });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        showTab(tab.dataset.tab);
        history.replaceState(null, '', '#' + tab.dataset.tab);
      });
    });

    const hash = window.location.hash.replace('#', '');
    if (hash) showTab(hash);
  });
</script>

<%- include('../partials/footer') %>