<%- include('../partials/header', { active: 'seasons', pageTitle: season.name }) %>

<section class="hero" style="min-height:50vh;padding:3rem 2rem">
  <div class="hero-content">
    <div class="hero-badge"><%= season.name %> - <%= season.year %></div>
    <h1><%= season.name %> <span class="highlight">Details</span></h1>
    <p>T<%= season.overs %> Fast Cricket | Format: <%= season.format %></p>
  </div>
</section>

<div class="season-tabs">
  <a href="#points" class="season-tab active" data-tab="points">🏆 Points Table</a>
  <a href="#matches" class="season-tab" data-tab="matches">📅 Matches</a>
  <a href="#playoff" class="season-tab" data-tab="playoff">🏅 Playoffs</a>
  <a href="#stats" class="season-tab" data-tab="stats">📊 Stats</a>
</div>

<section class="section season-tab-content" id="points-content">
  <div class="section-title"><h2>Points <span class="highlight">Table</span></h2></div>
  <% if (season.pointsTable && season.pointsTable.length > 0) { %>
    <table class="standings-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Tm</th>
          <th>Played</th>
          <th>Won</th>
          <th>Lost</th>
          <th>Tied</th>
          <th>Points</th>
          <th>NRR</th>
        </tr>
      </thead>
      <tbody>
        <% season.pointsTable.map((s, i) => ({ s, i })).sort((a, b) => b.s.points - a.s.points).forEach(({ s, i }) => {
          const teamData = data.teams.find(t => t.name === s.team);
        %>
          <tr>
            <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
            <td>
              <div class="team-name-cell">
                <img src="<%= teamData ? teamData.logoUrl : '' %>" alt="<%= s.team %>" class="table-logo" onerror="this.style.display='none'">
                <a href="/team/<%= teamData ? teamData.id : '#' %>" style="color:var(--text)"><%= s.team %></a>
              </div>
            </td>
            <td><%= s.played %></td>
            <td style="color:#2ecc71"><%= s.won %></td>
            <td style="color:#e74c3c"><%= s.lost %></td>
            <td><%= s.tied %></td>
            <td style="font-weight:700;color:var(--gold)"><%= s.points %></td>
            <td><%= s.nrr %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p style="text-align:center;color:var(--text-light)">Points table not available yet.</p>
  <% } %>
</section>

<section class="section season-tab-content" id="matches-content" style="display:none">
  <div class="section-title"><h2>League <span class="highlight">Matches</span></h2></div>
  <div class="schedule-container">
    <% if (season.matches && season.matches.length > 0) { %>
      <% season.matches.forEach(match => {
        const t1 = data.teams.find(t => t.name === match.team1);
        const t2 = data.teams.find(t => t.name === match.team2);
        const hasScore = match.innings && match.innings.length > 0 && match.innings[0].length > 0;
      %>
        <div class="match-card">
          <div class="match-info">
            <div class="match-label"><%= match.match %></div>
            <div class="match-teams">
              <span class="match-team"><img src="<%= t1 ? t1.logoUrl : '' %>" alt="<%= match.team1 %>" class="mini-logo" onerror="this.style.display='none'"><%= match.team1 %></span>
              <span class="vs">vs</span>
              <span class="match-team"><%= match.team2 %><img src="<%= t2 ? t2.logoUrl : '' %>" alt="<%= match.team2 %>" class="mini-logo" onerror="this.style.display='none'"></span>
            </div>
            <div class="match-meta">
              <span>📅 <%= match.date %></span>
              <span>⏰ <%= match.time %></span>
              <% if (match.status === 'live') { %>
                <span style="color:#e74c3c;font-weight:700">● LIVE: <%= match.inn1.runs %>/<%= match.inn1.wickets %> (<%= match.inn1.ballStr %>)</span>
              <% } else if (match.status === 'completed') { %>
                <span style="color:#2ecc71">✅ <%= match.result %></span>
              <% } else if (match.inn2 && match.inn2.legalBalls > 0) { %>
                <span style="color:var(--accent)">🏏 <%= match.team2 %>: <%= match.inn2.runs %>/<%= match.inn2.wickets %> (<%= match.inn2.ballStr %>)</span>
              <% } else if (hasScore) { %>
                <span style="color:var(--accent)">🏏 <%= match.team1 %>: <%= match.inn1.runs %>/<%= match.inn1.wickets %> (<%= match.inn1.ballStr %>)</span>
              <% } %>
            </div>
            <div style="margin-top:0.6rem">
              <a href="/match/<%= match.id %>" class="btn btn-sm btn-outline">📋 Scorecard</a>
            </div>
          </div>
          <% if (match.status === 'live') { %>
            <span class="match-status live-badge"><span class="live-dot"></span> LIVE</span>
          <% } else if (match.status === 'completed') { %>
            <span class="match-status status-completed">Completed</span>
          <% } else { %>
            <span class="match-status status-upcoming">Upcoming</span>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p style="text-align:center;color:var(--text-light)">No matches scheduled yet.</p>
    <% } %>
  </div>
</section>

<section class="section season-tab-content" id="playoff-content" style="display:none">
  <div class="section-title"><h2>Playoffs & <span class="highlight">Final</span></h2></div>
  <% if (!((season.matches || []).every(m => m.status === 'completed'))) { %>
    <div class="format-card" style="text-align:center;padding:2rem;max-width:640px;margin:0 auto 2rem">
      <div style="font-size:2.5rem;margin-bottom:0.8rem">🏅</div>
      <h3 style="margin-bottom:0.5rem">Playoff spots lock automatically</h3>
      <p style="color:var(--text-light)">Playoff spots will be filled automatically from the points table once all league matches are completed.</p>
    </div>
  <% } %>
  <div class="schedule-container">
    <% if (season.playoff && season.playoff.length > 0) { %>
      <% season.playoff.forEach(match => {
        const t1 = data.teams.find(t => t.name === match.team1);
        const t2 = data.teams.find(t => t.name === match.team2);
        const hasScore = match.innings && match.innings.length > 0 && match.innings[0].length > 0;
      %>
        <div class="match-card">
          <div class="match-info">
            <div class="match-label" style="color:var(--accent)">⭐ <%= match.match %></div>
            <div class="match-teams">
              <span class="match-team"><img src="<%= t1 ? t1.logoUrl : '' %>" alt="<%= match.team1 %>" class="mini-logo" onerror="this.style.display='none'"><%= match.team1 %></span>
              <span class="vs">vs</span>
              <span class="match-team"><%= match.team2 %><img src="<%= t2 ? t2.logoUrl : '' %>" alt="<%= match.team2 %>" class="mini-logo" onerror="this.style.display='none'"></span>
            </div>
            <div class="match-meta">
              <span>📅 <%= match.date %></span>
              <span>⏰ <%= match.time %></span>
              <% if (match.status === 'completed') { %>
                <span style="color:#2ecc71">✅ <%= match.result %></span>
              <% } else if (match.status === 'live') { %>
                <span style="color:#e74c3c;font-weight:700">● LIVE</span>
              <% } %>
            </div>
            <div style="margin-top:0.6rem">
              <a href="/match/<%= match.id %>" class="btn btn-sm btn-outline">📋 Scorecard</a>
            </div>
          </div>
          <% if (match.status === 'live') { %>
            <span class="match-status live-badge"><span class="live-dot"></span> LIVE</span>
          <% } else if (match.status === 'completed') { %>
            <span class="match-status status-completed">Completed</span>
          <% } else { %>
            <span class="match-status status-upcoming">Upcoming</span>
          <% } %>
        </div>
      <% }) %>
    <% } else { %>
      <p style="text-align:center;color:var(--text-light)">Playoffs not scheduled yet.</p>
    <% } %>
  </div>
</section>

<section class="section season-tab-content" id="stats-content" style="display:none">
  <div class="section-title"><h2>Season <span class="highlight">Stats</span></h2></div>

  <% 
    const runsList = (season.stats && season.stats.topRunScorers) || [];
    const wktsList = (season.stats && season.stats.topWicketTakers) || [];
    const byFours = runsList.slice().sort((a, b) => b.fours - a.fours);
    const bySixes = runsList.slice().sort((a, b) => b.sixes - a.sixes);
    const bySr = runsList.slice().sort((a, b) => parseFloat(b.sr) - parseFloat(a.sr));
    const byAvg = runsList.slice().sort((a, b) => parseFloat(b.avg) - parseFloat(a.avg));
    const byEco = wktsList.slice().sort((a, b) => parseFloat(a.eco) - parseFloat(b.eco));
    const byBowling = wktsList.slice().sort((a, b) => b.wickets - a.wickets || parseFloat(a.avg) - parseFloat(b.avg));
    const byFifties = data.players.filter(p => (p.fifties || 0) > 0).sort((a, b) => b.fifties - a.fifties);
    const byCenturies = data.players.filter(p => (p.centuries || 0) > 0).sort((a, b) => b.centuries - a.centuries);
    const byCatches = data.players.filter(p => (p.catches || 0) > 0).sort((a, b) => b.catches - a.catches);

    function teamCell(name) {
      const t = data.teams.find(x => x.name === name);
      const img = t ? '<img src="' + t.logoUrl + '" alt="' + name + '" class="table-logo" onerror="this.style.display=\'none\'">' : '';
      return img + '<span style="color:var(--text-light)">' + name + '</span>';
    }
    function playerLink(name) {
      const pl = data.players.find(x => x.name === name);
      if (pl) return '<a href="/player/' + pl.id + '" style="color:var(--text)">' + name + '</a>';
      return '<span style="color:var(--text)">' + name + '</span>';
    }
    function teamLogo(name, cls) {
      const t = data.teams.find(x => x.name === name);
      return t ? '<img src="' + t.logoUrl + '" alt="' + name + '" class="' + cls + '" onerror="this.style.display=\'none\'">' : '';
    }
  %>

  <div class="stats-grid">
    <!-- Top Run Scorers -->
    <div class="format-card stats-card">
      <h3>🏏 Top Run Scorers</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>Runs</th><th>Avg</th><th>Best</th></tr></thead>
        <tbody>
          <% if (runsList.length > 0) { runsList.map((p, i) => ({ p, i })).sort((a, b) => b.p.runs - a.p.runs).forEach(({ p, i }) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.runs %></td>
              <td><%= p.avg %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="8" style="text-align:center;color:var(--text-light)">No batting stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Best Batting Average -->
    <div class="format-card stats-card">
      <h3>📊 Best Batting Average</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>Avg</th><th>Runs</th></tr></thead>
        <tbody>
          <% if (byAvg.length > 0) { byAvg.slice(0, 5).forEach((p, i) => { %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td><%- playerLink(p.player) %></td>
              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.avg %></td>
              <td><%= p.runs %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="7" style="text-align:center;color:var(--text-light)">No batting average stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Top Wicket Takers -->
