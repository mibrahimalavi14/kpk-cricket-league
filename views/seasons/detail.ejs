              <td class="team-name-cell"><%- teamCell(p.team) %></td>
              <td><%= p.matches || 0 %></td>
              <td><%= p.innings || 0 %></td>
              <td style="font-weight:700;color:var(--accent)"><%= p.wickets %></td>
              <td><%= p.best %></td>
            </tr>
          <% }) } else { %>
            <tr><td colspan="7" style="text-align:center;color:var(--text-light)">No bowling stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Most Fours -->
    <div class="format-card stats-card">
      <h3>4️⃣ Most Fours</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>4s</th></tr></thead>
        <tbody>
          <% if (byFours.length > 0) { byFours.slice(0, 5).forEach((p, i) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.player) %></td><td class="team-name-cell"><%- teamCell(p.team) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td style="font-weight:700;color:var(--accent)"><%= p.fours %></td></tr>
          <% }) } else { %>
            <tr><td colspan="6" style="text-align:center;color:var(--text-light)">No fours stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Most Sixes -->
    <div class="format-card stats-card">
      <h3>💣 Most Sixes</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>6s</th></tr></thead>
        <tbody>
          <% if (bySixes.length > 0) { bySixes.slice(0, 5).forEach((p, i) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.player) %></td><td class="team-name-cell"><%- teamCell(p.team) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td style="font-weight:700;color:var(--accent)"><%= p.sixes %></td></tr>
          <% }) } else { %>
            <tr><td colspan="6" style="text-align:center;color:var(--text-light)">No sixes stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Best Strike Rate -->
    <div class="format-card stats-card">
      <h3>⚡ Best Strike Rate</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>SR</th></tr></thead>
        <tbody>
          <% if (bySr.length > 0) { bySr.slice(0, 5).forEach((p, i) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.player) %></td><td class="team-name-cell"><%- teamCell(p.team) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td style="font-weight:700;color:var(--accent)"><%= p.sr %></td></tr>
          <% }) } else { %>
            <tr><td colspan="6" style="text-align:center;color:var(--text-light)">No strike rate stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Best Bowling -->
    <div class="format-card stats-card">
      <h3>🏅 Best Bowling Figures</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>W</th><th>Best</th></tr></thead>
        <tbody>
          <% if (byBowling.length > 0) { byBowling.slice(0, 5).forEach((p, i) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.player) %></td><td class="team-name-cell"><%- teamCell(p.team) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td><%= p.wickets %></td><td style="font-weight:700;color:var(--accent)"><%= p.best %></td></tr>
          <% }) } else { %>
            <tr><td colspan="7" style="text-align:center;color:var(--text-light)">No bowling stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Best Economy -->
    <div class="format-card stats-card">
      <h3>🛡️ Best Economy Rate</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>Eco</th></tr></thead>
        <tbody>
          <% if (byEco.length > 0) { byEco.slice(0, 5).forEach((p, i) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.player) %></td><td class="team-name-cell"><%- teamCell(p.team) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td style="font-weight:700;color:var(--accent)"><%= p.eco %></td></tr>
          <% }) } else { %>
            <tr><td colspan="6" style="text-align:center;color:var(--text-light)">No economy stats yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Most Fifties -->
    <div class="format-card stats-card">
      <h3>50️⃣ Most Fifties</h3>
      <table class="standings-table compact-table">
        <thead><tr><th>#</th><th>Pl</th><th>Tm</th><th>M</th><th>Inns</th><th>50s</th></tr></thead>
        <tbody>
          <% if (byFifties.length > 0) { byFifties.map((p, i) => ({ p, i })).forEach(({ p, i }) => { %>
            <tr><td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td><td><%- playerLink(p.name) %></td><td class="team-name-cell"><%- teamCell(p.teamName) %></td><td><%= p.matches || 0 %></td><td><%= p.innings || 0 %></td><td style="font-weight:700;color:var(--accent)"><%= p.fifties %></td></tr>
          <% }) } else { %>
