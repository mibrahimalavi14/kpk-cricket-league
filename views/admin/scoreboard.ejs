<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Score - <%= match.match %> - Admin</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css?v=12">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-header">
        <h2>🏏 KPK League</h2>
        <p>Admin Panel</p>
      </div>
      <nav>
        <a href="/admin">📊 Dashboard</a>
        <a href="/admin/teams">🛡️ Teams</a>
        <a href="/admin/players">⭐ Players</a>
        <a href="/admin/seasons" class="active">🏆 Seasons</a>
        <a href="/admin/logout">🚪 Logout</a>
      </nav>
    </aside>
    <main class="admin-main">
      <div class="admin-header">
        <h1>⚡ Live Scoring - <%= match.match %></h1>
        <div>
          <a href="/admin/season/<%= season.id %>" class="btn back-btn">← Back to Season</a>
          <a href="/match/<%= match.id %>" class="btn btn-sm btn-outline">Public Page</a>
        </div>
      </div>

      <div class="scoreboard-box">
        <div class="sb-match">
          <span class="sb-teams"><%= match.team1 %> <span class="vs">vs</span> <%= match.team2 %></span>
          <% if (match.status === 'live') { %>
            <span class="live-badge"><span class="live-dot"></span> LIVE</span>
          <% } else if (match.status === 'completed') { %>
            <span style="color:#2ecc71;font-weight:700">✅ <%= match.result || 'Completed' %></span>
          <% } else { %>
            <span style="color:#f39c12;font-weight:600">Not started</span>
          <% } %>
        </div>

        <% if (match.status === 'upcoming' && (!match.innings || match.innings.length === 0 || match.innings[0].length === 0)) { %>
          <form action="/admin/season/<%= season.id %>/match/<%= match.id %>/start" method="POST" style="text-align:center;padding:1.5rem">
            <h3 style="margin-bottom:1rem">Start Match Scoring</h3>
            <label style="margin-right:0.5rem">Winning the toss:</label>
            <select name="toss" style="padding:0.5rem;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,0.05);color:var(--text)">
              <option value="<%= match.team1 %>"><%= match.team1 %></option>
              <option value="<%= match.team2 %>"><%= match.team2 %></option>
            </select>
            <button type="submit" class="btn btn-primary" style="margin-left:0.5rem">▶ Start Match</button>
          </form>
        <% } else { %>

          <!-- SCORES -->
          <div class="sb-scores">
            <div class="sb-score">
              <div class="sb-team-name"><%= match.team1 %></div>
              <div class="sb-score-val"><%= match.inn1.runs %>/<%= match.inn1.wickets %></div>
              <div class="sb-score-sub"><%= match.inn1.ballStr %> ov · CRR <%= match.inn1.crr %></div>
            </div>
            <% if (match.inSuperOver) { %>
              <div class="sb-vs">TIE MATCH → SUPER OVER<br><%= match.target ? 'Target ' + match.target : '' %></div>
            <% } else if (match.inn2 && match.inn2.legalBalls > 0) { %>
              <div class="sb-vs">2nd Inns <%= match.target ? '· Target ' + match.target : '' %></div>
            <% } else { %>
              <div class="sb-vs">vs</div>
            <% } %>
            <div class="sb-score">
              <div class="sb-team-name"><%= match.team2 %></div>
              <div class="sb-score-val"><%= match.inn2 && match.inn2.legalBalls > 0 ? match.inn2.runs + '/' + match.inn2.wickets : '—' %></div>
              <div class="sb-score-sub"><%= match.inn2 && match.inn2.legalBalls > 0 ? match.inn2.ballStr + ' ov · CRR ' + match.inn2.crr : 'Yet to bat' %></div>
            </div>
          </div>
          <% if (match.inSuperOver && match.superOverLegs && match.superOverLegs.length) { %>
            <div class="sb-so-box">
              <% match.superOverLegs.forEach(leg => { %>
                <span class="banner-so-leg">⭐ SO<%= leg.leg %>: <%= leg.team %> <%= leg.inn.runs %>/<%= leg.inn.wickets %></span>
              <% }) %>
            </div>
          <% } %>

          <%
            const curLen = match.innings.length;
            const lastIdx = curLen - 1;
            const isSO = lastIdx >= 2;
            const battTeam = isSO ? (lastIdx % 2 === 0 ? match.team2 : match.team1) : (curLen === 1 ? match.team1 : match.team2);
            const bowlTeam = battTeam === match.team1 ? match.team2 : match.team1;
            const curRaw = match.innings[lastIdx] || [];
            const curQuota = isSO ? 1 : season.overs;
            const curInn = c.inningsSummary(curRaw, curQuota, c.squadSizeFor(battTeam, data));
            const battPlayers = (data.players || []).filter(p => p.teamName === battTeam);
            const bowlPlayers = (data.players || []).filter(p => p.teamName === bowlTeam);
            const quota = season.overs;
          %>

          <% if (curInn.done && match.status === 'live') { %>
            <div class="sb-notice">⏰ Current innings over (<%= curInn.allOut ? 'All Out' : 'Overs complete' %>)</div>
          <% } %>

          <!-- BALL ENTRY -->
          <% if (!curInn.done && match.status !== 'completed') { %>
            <%
              const soMode = match.inSuperOver;
              const soLabel = soMode ? '⭐ Super Over' : '';
              const strikerPref = [...curInn.batting].reverse().find(b => !b.out) || curInn.batting[0];
              const bowlerPref = curInn.bowling.length ? curInn.bowling[curInn.bowling.length - 1].player : (bowlPlayers[0] ? bowlPlayers[0].name : '');
            %>
            <div class="sb-form">
              <h3>
                <%= soLabel ? (soLabel + ' — ') : '' %>Add Ball - <%= battTeam %> batting
                <% if (match.toss) { %><span class="sb-rules" style="font-weight:400">· Toss: <b><%= match.toss %></b> won</span><% } %>
              </h3>
              <div class="sb-rules sb-rules-box">
                <strong>Scoring rules:</strong> 0 / 1 / 2 / 3 off the bat · <span style="color:#b07ce0">FOUR</span> = 4 runs (boundary) · <span style="color:var(--gold)">SIX</span> = 6 runs (over the rope). <b>Wide</b> = +1 run (no extra ball does not count as a legal ball) · <b>No Ball</b> = +1 run + a free hit next delivery · <b>Byes</b> = runs taken without touching the bat · <b>Leg Byes</b> = runs when the ball hits the pad. Overs: T<%= season.overs %> per innings; the team batting second must beat the target to avoid a tie.
              </div>
              <form id="ballForm" action="/admin/season/<%= season.id %>/match/<%= match.id %>/ball" method="POST">
                <div class="sb-form-row">
                  <div class="sb-field">
                    <label>Striker</label>
                    <input type="text" name="striker" list="batters" value="<%= strikerPref ? strikerPref.player : '' %>" placeholder="Striker" required style="width:100%">
                  </div>
                  <div class="sb-field">
                    <label>Bowler</label>
                    <input type="text" name="bowler" list="bowlers" value="<%= bowlerPref %>" placeholder="Bowler" required style="width:100%">
                  </div>
                </div>
                <datalist id="batters"><% battPlayers.forEach(p => { %><option value="<%= p.name %>"><% }) %></datalist>
                <datalist id="bowlers"><% bowlPlayers.forEach(p => { %><option value="<%= p.name %>"><% }) %></datalist>

                <input type="hidden" name="batRuns" id="batRuns" value="0">
                <input type="hidden" name="extraType" id="extraType" value="">
                <input type="hidden" name="extraRuns" id="extraRuns" value="0">
                <input type="hidden" name="isWicket" id="isWicket" value="0">
                <input type="hidden" name="wicketType" id="wicketType" value="">
                <input type="hidden" name="fielder" id="fielder" value="">

                <div class="sb-form-row">
                  <div class="sb-field">
                    <label>Runs off bat</label>
                    <div class="run-btn-row">
                      <button type="button" class="run-btn" onclick="addBall(0)">0</button>
                      <button type="button" class="run-btn" onclick="addBall(1)">1</button>
                      <button type="button" class="run-btn" onclick="addBall(2)">2</button>
                      <button type="button" class="run-btn" onclick="addBall(3)">3</button>
                      <button type="button" class="run-btn run-four" onclick="addBall(4)">FOUR 4</button>
                      <button type="button" class="run-btn run-six" onclick="addBall(6)">SIX 6</button>
                    </div>
                  </div>
                  <div class="sb-field">
                    <label>Extras</label>
                    <div class="run-btn-row">
                      <button type="button" class="run-btn run-wd" onclick="addExtra('wd',<%= match.inn2 && match.inn2.legalBalls > 0 ? 1 : 1 %>)">Wide +1</button>
                      <button type="button" class="run-btn run-nb" onclick="addExtra('nb',1)">No Ball +1</button>
                      <button type="button" class="run-btn run-by" onclick="addExtra('by',1)">Byes +1</button>
                      <button type="button" class="run-btn run-lb" onclick="addExtra('lb',1)">Leg Byes +1</button>
                    </div>
                  </div>
                </div>

                <div class="sb-form-row">
                  <div class="sb-field sb-wicket">
                    <label>Wicket</label>
                    <div class="wicket-row">
                      <button type="button" class="btn btn-sm btn-danger" style="background:#e74c3c" onclick="toggleWicket()">🦴 Take Wicket</button>
                    </div>
                    <div id="wk-details" style="display:none;grid-template-columns:1fr 1fr;gap:0.5rem;margin-top:0.6rem">
                      <select id="wicketTypeSelect" style="width:100%">
                        <option value="bowled">Bowled</option>
                        <option value="caught">Caught</option>
                        <option value="lbw">LBW</option>
                        <option value="runout">Run Out</option>
                        <option value="stumped">Stumped</option>
                        <option value="hitwicket">Hit Wicket</option>
                        <option value="other">Other</option>
                      </select>
                      <input type="text" id="fielderInput" placeholder="Fielder (caught/stumped)" style="width:100%">
                    </div>
                  </div>
                </div>

                <div class="sb-form-row" style="margin-top:0.5rem">
                  <button type="button" class="btn btn-primary" style="width:100%" onclick="document.getElementById('addBallNotice').style.display='block'; setTimeout(function(){ document.getElementById('addBallNotice').style.display='none'; },3000);">+ Add Ball (or click a run/extra button)</button>
                  <div id="addBallNotice" style="display:none;color:var(--gold);text-align:center;width:100%;margin-top:0.4rem;font-weight:700">Click any run (0/1/2/3/FOUR/SIX) or extra (Wide/No Ball/Byes/Leg Byes) button above — that ball is added instantly.</div>
                </div>
              </form>
            </div>
          <% } %>

          <!-- CURRENT BATSMEN -->
          <% if (curInn.batting.length > 0) { %>
            <div class="sb-live-table">
              <h3>🏏 <%= battTeam %> Batters</h3>
              <table class="admin-table">
                <thead><tr><th>Batter</th><th>R</th><th>B</th><th>4s</th><th>6s</th><th>SR</th><th>Status</th></tr></thead>
                <tbody>
                  <% curInn.batting.forEach(b => { %>
                    <tr>
                      <td><%= b.player %></td>
                      <td><%= b.runs %></td><td><%= b.balls %></td><td><%= b.fours %></td><td><%= b.sixes %></td><td><%= b.sr.toFixed(2) %></td>
                      <td style="color:<%= b.out ? '#e74c3c' : '#2ecc71' %>"><%= b.out ? b.howOut : 'Not out' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <!-- BOWLERS -->
          <% if (curInn.bowling.length > 0) { %>
            <div class="sb-live-table">
              <h3>🎯 <%= bowlTeam %> Bowlers</h3>
              <table class="admin-table">
                <thead><tr><th>Bowler</th><th>O</th><th>R</th><th>W</th><th>Econ</th></tr></thead>
                <tbody>
                  <% curInn.bowling.forEach(b => { %>
                    <tr><td><%= b.player %></td><td><%= b.overs %></td><td><%= b.runs %></td><td><%= b.wickets %></td><td><%= b.eco.toFixed(2) %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>

          <!-- ACTIONS -->
          <div class="sb-actions">
            <% if (match.status === 'live') { %>
              <% if (curLen === 1 && curInn.done) { %>
                <form action="/admin/season/<%= season.id %>/match/<%= match.id %>/endinnings" method="POST" style="display:inline">
                  <button type="submit" class="btn btn-primary">▶ Start 2nd Innings (Target <%= match.target %>)</button>
                </form>
              <% } %>
              <% if (curLen >= 2 && curInn.done) { %>
                <%
                  const soOpenNext = match.inSuperOver && curLen % 2 === 1;
                %>
                <form action="/admin/season/<%= season.id %>/match/<%= match.id %>/complete" method="POST" style="display:inline">
                  <button type="submit" class="btn btn-gold"><%= soOpenNext ? '▶ Start Super Over 2nd Leg' : '🏁 ' + (match.inSuperOver ? 'Complete Super Over (Auto Result)' : 'Complete Match (Auto Result)') %></button>
                </form>
              <% } %>
              <form action="/admin/season/<%= season.id %>/match/<%= match.id %>/undo" method="POST" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline">↩ Undo Last Ball</button>
              </form>
            <% } %>
            <form action="/admin/season/<%= season.id %>/match/<%= match.id %>/reset" method="POST" style="display:inline" onsubmit="return confirm('Reset all scoring data for this match?')">
              <button type="submit" class="btn btn-sm btn-danger" style="background:#e74c3c">🗑 Reset Match</button>
            </form>
          </div>

          <% if (match.innings.some(inArr => inArr.length > 0)) { %>
            <div class="sb-live-table">
              <h3>📜 Ball by Ball</h3>
              <div class="commentary-feed">
                <% match.innings.forEach((inArr, ii) => {
                  inArr.forEach((b, i) => {
                    const txt = b.extraType === 'wd' ? 'Wide +' + b.extraRuns
                      : b.extraType === 'nb' ? 'No Ball +' + b.extraRuns
                      : b.extraType === 'by' ? 'Byes +' + b.extraRuns
                      : b.extraType === 'lb' ? 'Leg Byes +' + b.extraRuns
                      : b.isWicket ? 'WICKET - ' + b.striker + ' ' + b.wicketType
                      : b.batRuns === 6 ? 'SIX! by ' + b.striker
                      : b.batRuns === 4 ? 'FOUR! by ' + b.striker
                      : b.batRuns > 0 ? b.batRuns + ' run' + (b.batRuns === 1 ? '' : 's') + ' by ' + b.striker
                      : 'Dot ball by ' + b.bowler; %>
                    <span class="commentary-ball <%= b.isWicket ? 'cb-wicket' : '' %>"><%= ii + 1 %>.<%= i + 1 %><%= b.legal ? '' : '*' %> <%= txt %> (<%= b.over %>.<%= b.ball %>)</span>
                  <% });
                }) %>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>
    </main>
  </div>
  <script>
    function addBall(v) {
      var f = document.getElementById('ballForm');
      document.getElementById('batRuns').value = v;
      document.getElementById('extraType').value = '';
      document.getElementById('extraRuns').value = '0';
      document.getElementById('isWicket').value = '0';
      f.submit();
    }
    function addExtra(type, runs) {
      var f = document.getElementById('ballForm');
      document.getElementById('batRuns').value = '0';
      document.getElementById('extraType').value = type;
      document.getElementById('extraRuns').value = runs;
      document.getElementById('isWicket').value = '0';
      f.submit();
    }
    function toggleWicket() {
      var d = document.getElementById('wk-details');
      var on = d.style.display === 'grid';
      d.style.display = on ? 'none' : 'grid';
      if (!on) return;
      document.getElementById('wicketTypeSelect').value = document.getElementById('wicketTypeSelect').value || 'bowled';
    }
    function submitWicket() {
      var f = document.getElementById('ballForm');
      document.getElementById('batRuns').value = '0';
      document.getElementById('extraType').value = '';
      document.getElementById('isWicket').value = '1';
      document.getElementById('wicketType').value = document.getElementById('wicketTypeSelect').value;
      document.getElementById('fielder').value = document.getElementById('fielderInput').value;
      window.wicketSubmitting = true;
      f.submit();
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.sb-wicket .btn-danger')) {
        var el = e.target.closest('.sb-wicket .btn-danger');
        el.textContent = '✓ Confirm Wicket';
        el.style.background = '#c0392b';
        el.onclick = submitWicket;
      }
    });
  </script>
</body>
</html>