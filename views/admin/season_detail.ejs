<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage <%= season.name %> - Admin</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/style.css?v=5">
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-header">
        <h2>🏏 KPK League</h2>
        <p>Admin Panel</p>
      </div>
      <nav>
        <a href="/admin">📊 Dashboard</a>
        <a href="/admin/teams">🛡️ Teams</a>
        <a href="/admin/players">⭐ Players</a>
        <a href="/admin/seasons" class="active">🏆 Seasons</a>
        <a href="/admin/logout">🚪 Logout</a>
      </nav>
    </aside>
    <main class="admin-main">
      <div class="admin-header">
        <h1><%= season.name %> - <%= season.year %> (T<%= season.overs %>)</h1>
        <a href="/season/<%= season.id %>" class="btn btn-sm btn-outline">View Public Page</a>
      </div>

      <div class="admin-tabs" style="display:flex;gap:0.5rem;margin-bottom:2rem;flex-wrap:wrap">
        <a href="#points" class="btn btn-sm btn-outline">Points Table</a>
        <a href="#matches" class="btn btn-sm btn-outline">Matches & Scoring</a>
        <a href="#playoff" class="btn btn-sm btn-outline">Playoffs</a>
        <a href="#stats" class="btn btn-sm btn-outline">Stats</a>
      </div>

      <div class="format-card" style="margin-bottom:2rem;background:rgba(46,204,113,0.08);border-color:rgba(46,204,113,0.3)">
        <p style="margin:0">✅ <strong>Sab kuch auto-compute hota hai.</strong> Points table, stats, playoff teams aur results scorecards se automatically calculate hote hain — manual entry ki zaroorat nahi. Sirf matches score karo.</p>
      </div>

      <!-- POINTS TABLE (auto) -->
      <h2 id="points" style="margin-bottom:1rem;font-size:1.2rem">Points Table <span style="font-size:0.75rem;color:var(--text-light)">(auto)</span></h2>
      <table class="admin-table">
        <thead>
          <tr><th>#</th><th>Team</th><th>Played</th><th>Won</th><th>Lost</th><th>Tied</th><th>NRR</th><th>Points</th></tr>
        </thead>
        <tbody>
          <% season.pointsTable.slice().sort((a, b) => b.points - a.points || parseFloat(b.nrr) - parseFloat(a.nrr)).forEach((row, i) => {
            const teamData = data.teams.find(t => t.name === row.team);
          %>
            <tr>
              <td style="font-weight:700;color:var(--gold)"><%= i + 1 %></td>
              <td>
                <span style="display:inline-flex;align-items:center;gap:0.5rem">
                  <span style="width:10px;height:10px;border-radius:2px;background:<%= teamData ? teamData.color : '#666' %>"></span>
                  <%= row.team %>
                </span>
              </td>
              <td><%= row.played %></td>
              <td><%= row.won %></td>
              <td><%= row.lost %></td>
              <td><%= row.tied %></td>
              <td><%= row.nrr %></td>
              <td style="font-weight:700;color:var(--gold)"><%= row.points %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- MATCHES -->
      <h2 id="matches" style="margin:2.5rem 0 1rem;font-size:1.2rem">League Matches & Scoring</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Match</th><th>Team 1</th><th>Team 2</th><th>Date</th><th>Time</th><th>Status</th><th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% season.matches.forEach((match, idx) => { %>
            <tr>
              <td style="color:var(--gold)"><%= match.match %></td>
              <td>
                <select name="team1" form="matchForm_<%= idx %>" style="width:120px">
                  <% data.teams.forEach(t => { %>
                    <option value="<%= t.name %>" <%= match.team1 === t.name ? 'selected' : '' %>><%= t.name %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <select name="team2" form="matchForm_<%= idx %>" style="width:120px">
                  <% data.teams.forEach(t => { %>
                    <option value="<%= t.name %>" <%= match.team2 === t.name ? 'selected' : '' %>><%= t.name %></option>
                  <% }) %>
                </select>
              </td>
              <td><input type="date" name="date" form="matchForm_<%= idx %>" value="<%= match.date %>"></td>
              <td><input type="time" name="time" form="matchForm_<%= idx %>" value="<%= match.time %>"></td>
              <td>
                <% if (match.status === 'live') { %>
                  <span class="live-badge"><span class="live-dot"></span> LIVE</span>
                <% } else if (match.status === 'completed') { %>
                  <span style="color:#2ecc71;font-weight:600">✅ <%= match.result %></span>
                <% } else { %>
                  <span style="color:#f39c12;font-weight:600">Upcoming</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/season/<%= season.id %>/match/<%= match.id %>" class="btn btn-sm btn-gold">⚡ Score</a>
                <form id="matchForm_<%= idx %>" action="/admin/season/<%= season.id %>/matches/<%= idx %>" method="POST" style="display:inline">
                  <button type="submit" class="btn btn-sm btn-outline">Save</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- PLAYOFFS (auto) -->
      <h2 id="playoff" style="margin:2.5rem 0 1rem;font-size:1.2rem">Playoffs <span style="font-size:0.75rem;color:var(--text-light)">(auto - league rules)</span></h2>
      <table class="admin-table">
        <thead><tr><th>Match</th><th>Team 1</th><th>Team 2</th><th>Date</th><th>Time</th><th>Actions</th></tr></thead>
        <tbody>
          <% season.playoff.forEach((match, idx) => { %>
            <tr>
              <td style="color:var(--accent)">⭐ <%= match.match %></td>
              <td><%= match.team1 %></td>
              <td><%= match.team2 %></td>
              <td><%= match.date %></td>
              <td><%= match.time %></td>
              <td>
                <% if (match.status === 'completed' || (match.innings && match.innings.length > 0 && match.innings[0].length > 0)) { %>
                  <a href="/admin/season/<%= season.id %>/match/<%= match.id %>" class="btn btn-sm btn-gold">⚡ Score</a>
                <% } else { %>
                  <span style="color:var(--text-light);font-size:0.8rem">Waiting for league completion</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p style="color:var(--text-light);font-size:0.85rem">Rules: Top team → Grand Final direct · 2nd vs 3rd → Qualifier · Qualifier winner → Final (all auto-filled).</p>

      <!-- STATS (auto) -->
      <h2 id="stats" style="margin:2.5rem 0 1rem;font-size:1.2rem">Season Stats <span style="font-size:0.75rem;color:var(--text-light)">(auto)</span></h2>
      <h3 style="margin-bottom:1rem;font-size:1rem;color:var(--gold)">Top Run Scorers</h3>
      <table class="admin-table" style="margin-bottom:2rem">
        <thead><tr><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Runs</th><th>Avg</th><th>SR</th><th>Best</th><th>4s</th><th>6s</th></tr></thead>
        <tbody>
          <% (season.stats && season.stats.topRunScorers || []).slice(0, 10).forEach(p => { %>
            <tr>
              <td><%= p.player %></td><td><%= p.team %></td><td><%= p.matches %></td><td><%= p.innings %></td>
              <td style="font-weight:700"><%= p.runs %></td><td><%= p.avg %></td><td><%= p.sr %></td><td><%= p.best %></td><td><%= p.fours %></td><td><%= p.sixes %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <h3 style="margin-bottom:1rem;font-size:1rem;color:var(--gold)">Top Wicket Takers</h3>
      <table class="admin-table">
        <thead><tr><th>Player</th><th>Team</th><th>M</th><th>Inns</th><th>Wickets</th><th>Avg</th><th>Econ</th><th>Best</th></tr></thead>
        <tbody>
          <% (season.stats && season.stats.topWicketTakers || []).slice(0, 10).forEach(p => { %>
            <tr>
              <td><%= p.player %></td><td><%= p.team %></td><td><%= p.matches %></td><td><%= p.innings %></td>
              <td style="font-weight:700"><%= p.wickets %></td><td><%= p.avg %></td><td><%= p.eco %></td><td><%= p.best %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </div>
</body>
</html>